  <point name="info_player_deathmatch" color="1 0.4 0.4" box="-16 -16 -24 16 16 32">Deathmatch player spawn.<angle key="angle" name="Facing" value="0"/><flag bit="0" name="Initial spawn"/><flag bit="1" name="No bots"/><flag bit="2" name="No humans"/></point>
