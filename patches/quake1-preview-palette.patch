+// Refresh palette conversion for newly loaded preview BSPs without restarting the editor VM.
+static void FTEBroom_ReloadPalette_f(void)
+{
+    extern qbyte default_quakepal[];
+    qbyte *palette;
+    size_t size = 0;
+    if (Cmd_IsInsecure() || !qrenderer)
+        return;
+    COM_WorkerFullSync();
+    palette = FS_LoadMallocFile("gfx/palette.lmp", &size);
+    if (!palette || size != 768)
+    {
+        BZ_Free(palette);
+        palette = BZ_Malloc(768);
+        memcpy(palette, default_quakepal, 768);
+    }
+    BZ_Free(host_basepal);
+    host_basepal = palette;
+    vid.fullbright = 32;
+    R_GenPaletteLookup();
+}
