+			// Tiny winding edges amplify rounding when a MAP reader reconstructs
+			// the plane. Use a deterministic, widely spaced basis on the actual
+			// plane instead of the first three (possibly collinear) vertices.
+			int dominant = 0, a, b, p;
+			for (p = 1; p < 3; ++p)
+				if (fabs(br->planes[i][p]) > fabs(br->planes[i][dominant])) dominant = p;
+			a = (dominant + 1) % 3;
+			b = (dominant + 2) % 3;
+			memset(point, 0, sizeof(point));
+			point[1][a] = 8192.0;
+			point[2][b] = br->planes[i][dominant] > 0 ? -8192.0 : 8192.0;
+			for (p = 0; p < 3; ++p)
+				point[p][dominant] = ((double)br->planes[i][3]
+					- point[p][a] * br->planes[i][a] - point[p][b] * br->planes[i][b])
+					/ br->planes[i][dominant];
+			// Canonicalize signed zero so repeated saves remain text-stable.
+			for (p = 0; p < 3; ++p)
+				if (point[p][dominant] == 0.0) point[p][dominant] = 0.0;
 
