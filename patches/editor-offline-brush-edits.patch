+// Offline editor models are already shared by the loopback client/server.
+// Re-sending every generated brush can overflow a reliable network message.
+static qboolean Terr_BrushNetworkEnabled(void)
+{
+#if defined(HAVE_SERVER) && defined(HAVE_CLIENT)
+    int i;
+    static cvar_t *offline;
+    if (!offline)
+        offline = Cvar_Get("ftebroom_offline_brush_edit", "0", 0, "FTEBroom");
+    if (offline->ival && sv.state && cls.state && cls.netchan.remote_address.type == NA_LOOPBACK)
+    {
+        for (i = 0; i < sv.allocated_client_slots; i++)
+            if (svs.clients[i].state >= cs_connected && svs.clients[i].netchan.remote_address.type != NA_LOOPBACK)
+                return true;
+        return false;
+    }
+#endif
+    return true;
+}
