diff --git a/engine/client/sys_linux.c b/engine/client/sys_linux.c
index 916e811..587bbef 100644
--- a/engine/client/sys_linux.c
+++ b/engine/client/sys_linux.c
@@ -1446,11 +1446,19 @@ static void SigChldTerminalDied(int code, void *data)
 	Sys_CloseTerminal();
 	Cbuf_AddText ("vid_renderer \"\"; vid_restart\n", RESTRICT_LOCAL);
 }
+static volatile sig_atomic_t editorChildProcesses;
 static void SigChld(int code)
 {
 	int wstat;
 	pid_t	pid;
 
+	// Editor jobs own their exit status; do not reap compiler or audio children.
+	if (editorChildProcesses)
+	{
+		if (dedconproc > 0 && waitpid(dedconproc, &wstat, WNOHANG) == dedconproc)
+			Cmd_AddTimer(0, SigChldTerminalDied, 0, NULL, 0);
+		return;
+	}
 	for(;;)
 	{
 		pid = wait3 (&wstat, WNOHANG, (struct rusage *)NULL);
@@ -1474,6 +1482,9 @@ int main (int c, const char **v)
 	signal(SIGFPE, SIG_IGN);
 	signal(SIGPIPE, SIG_IGN);
 #ifdef _POSIX_C_SOURCE
+	for (i = 1; i < c; ++i)
+		if (!strcmp(v[i], "-ftebroom-child-processes"))
+			editorChildProcesses = 1;
 	signal(SIGTTIN, SIG_IGN);	//have to ignore this if we want to not lock up when running backgrounded.
 	signal(SIGCONT, SigCont);
 	signal(SIGCHLD, SigChld);	//mapcluster stuff might leak zombie processes if we don't do this.
