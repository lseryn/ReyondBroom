+        for(i=0;i<8&&s->holes[i]==255;i++) {}
+        if(i!=8)continue;
+        Terr_GenerateDefault(hm,s);memset(s->holes,0,sizeof(s->holes));
+        for(i=0;i<SECTHEIGHTSIZE*SECTHEIGHTSIZE;i++)s->heights[i]=origin[2];
+        Q_strncpyz(s->texname[3],texture,sizeof(s->texname[3]));Terr_LoadSectionTextures(s);
+        s->minh=s->maxh=s->maxh_cull=origin[2];s->flags|=TSF_EDITED|TSF_DIRTY|TSF_NOTIFY|TSF_RELIGHT;
+    }
+    hm->traceseq++;return 1;
+}
