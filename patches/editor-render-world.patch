+// Editor-only render-world switching does not mutate the readonly world edict.
+static void QCBUILTIN PF_editor_renderworld(pubprogfuncs_t *prinst, struct globalvars_s *pr_globals)
+{
+    model_t *model = CSQC_GetModelForIndex((int)G_FLOAT(OFS_PARM0));
+    G_FLOAT(OFS_RETURN) = 0;
+    if (!model)
+        return;
+    while (model->loadstate == MLS_LOADING)
+        COM_WorkerPartialSync(model, &model->loadstate, MLS_LOADING);
+    if (model->loadstate != MLS_LOADED || (model->type != mod_brush && model->type != mod_heightmap))
+        return;
+    csqc_world.worldmodel = model;
+    cl.worldmodel = r_worldentity.model = model;
+    csqc_worldchanged = true;
+    G_FLOAT(OFS_RETURN) = 1;
 }
