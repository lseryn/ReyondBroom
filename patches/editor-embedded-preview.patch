+/* Only the runtime thread touches its child window and game input. */
+static void FTEBroom_PreviewInput_f(void)
+{
+    static qboolean held[1024];
+    const char *kind=Cmd_Argv(1);int i;
+    if(!COM_CheckParm("-ftebroom-preview"))return;
+    if(!strcmp(kind,"ack")){printf("ftebroom_camera_ack\n");fflush(stdout);return;}
+    if(!strcmp(kind,"reset")){
+        for(i=0;i<1024;i++)if(held[i]){Key_Event(0,i,0,false);held[i]=false;}
+        return;
+    }
+    if(!Cvar_VariableValue("ftebroom_preview_play"))return;
+    if(!strcmp(kind,"key") && Cmd_Argc()==5){
+        int key=atoi(Cmd_Argv(2)),unicode=atoi(Cmd_Argv(3)),down=atoi(Cmd_Argv(4));
+        if(key<=0 || key>=1024 || unicode<0 || unicode>0x10ffff || (down!=0 && down!=1))return;
+        held[key]=down;Key_Event(0,key,unicode,down);
+    }else if(!strcmp(kind,"mouse") && Cmd_Argc()==4){
+        float x,y;char tail;
+        if(sscanf(Cmd_Argv(2),"%f%c",&x,&tail)!=1 || sscanf(Cmd_Argv(3),"%f%c",&y,&tail)!=1)return;
+        if(x>=-8192 && x<=8192 && y>=-8192 && y<=8192)IN_MouseMove(0,0,x,y,0,0);
+    }
+}
