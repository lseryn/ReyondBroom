+/* The editor controls only the render camera; game simulation is untouched. */
+static void FTEBroom_PreviewCamera(void)
+{
+    float v[7]; int i;
+    if (!COM_CheckParm("-ftebroom-preview") || r_refdef.recurse || (r_refdef.flags & RDF_NOWORLDMODEL)) return;
+    if (sscanf(Cvar_VariableString("ftebroom_preview_camera"), "%f %f %f %f %f %f %f", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5], &v[6]) != 7) return;
+    for(i=0;i<7;i++) if (!(v[i]>=-1000000 && v[i]<=1000000)) return;
+    if(v[6]<10 || v[6]>170) return;
+    VectorCopy(v, r_refdef.vieworg);
+    VectorCopy(v, r_refdef.pvsorigin);
+    VectorCopy(v+3, r_refdef.viewangles);
+    r_refdef.externalview = true;
+    if(Cvar_VariableValue("ftebroom_preview_trace")) {
+        static vec3_t last;static qboolean reported;
+        if(!reported || !VectorEquals(last,v)){VectorCopy(v,last);reported=true;printf("ftebroom_preview_applied %g %g %g\n",v[0],v[1],v[2]);fflush(stdout);}
+    }
+    r_refdef.fov_x = v[6];
+    r_refdef.fov_y = atan(tan(v[6]*M_PI/360.0) * r_refdef.vrect.height / max(1,r_refdef.vrect.width))*360.0/M_PI;
+}
+
 void GLR_RenderView (void)
 {
 	int dofbo = *r_refdef.rt_destcolour[0].texname || *r_refdef.rt_depth.texname;
