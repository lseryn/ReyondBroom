+// Best-effort report: use Win32 I/O, with no plugin calls during a fatal exception.
+static void FTEBroom_CrashCopy(HANDLE output, const char *name)
+{
+    wchar_t path[4096]; char block[4096]; DWORD readbytes, written; HANDLE input; LARGE_INTEGER size,offset;
+    if (!name || !*name) return;
+    MultiByteToWideChar(CP_UTF8,0,name,-1,path,countof(path));
+    input=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ|FILE_SHARE_WRITE,NULL,OPEN_EXISTING,0,NULL);
+    if(input==INVALID_HANDLE_VALUE)return;
+    if(GetFileSizeEx(input,&size)&&size.QuadPart>1024*1024){offset.QuadPart=size.QuadPart-1024*1024;SetFilePointerEx(input,offset,NULL,FILE_BEGIN);}
+    while(ReadFile(input,block,sizeof(block),&readbytes,NULL)&&readbytes)WriteFile(output,block,readbytes,&written,NULL);
+    CloseHandle(input);
+}
+static void FTEBroom_CrashReport(const char *reason, qboolean append)
+{
+    wchar_t path[4096];HANDLE output;DWORD written;const char *name=Cvar_VariableString("ftebroom_crash_path");
+    if(!*name)return;
+    MultiByteToWideChar(CP_UTF8,0,name,-1,path,countof(path));
+    output=CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ,NULL,append?OPEN_ALWAYS:CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);
+    if(output==INVALID_HANDLE_VALUE){name=Cvar_VariableString("ftebroom_crash_fallback");if(!*name)return;MultiByteToWideChar(CP_UTF8,0,name,-1,path,countof(path));output=CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ,NULL,append?OPEN_ALWAYS:CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);}
+    if(output==INVALID_HANDLE_VALUE)return;
+    SetFilePointer(output,0,NULL,FILE_END);
+    WriteFile(output,reason,strlen(reason),&written,NULL);WriteFile(output,"\r\n",2,&written,NULL);
+    if(!append){FTEBroom_CrashCopy(output,Cvar_VariableString("ftebroom_crash_context"));FTEBroom_CrashCopy(output,Cvar_VariableString("ftebroom_crash_console"));}
+    FlushFileBuffers(output);CloseHandle(output);
+}
