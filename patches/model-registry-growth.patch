+// Entries never move: loaded worlds, workers and VM model indices retain their identity.
+typedef struct modelregistry_s {
+ model_t model;
+ struct modelregistry_s *next, *hashnext, *indexnext;
+ int index;
+} modelregistry_t;
+static void Mod_RegistryTest_f(void);
+static modelregistry_t *mod_first, *mod_last, *mod_hash[4096], *mod_indices[4096];
+int mod_numknown;
+model_t *Mod_NextKnownModel(model_t *model)
+{
+ modelregistry_t *entry = model ? ((modelregistry_t*)model)->next : mod_first;
+ return entry ? &entry->model : NULL;
+}
+model_t *Mod_KnownModel(int index)
+{
+ modelregistry_t *entry;
+ if (index < 0) return NULL;
+ for (entry = mod_indices[index % countof(mod_indices)]; entry; entry = entry->indexnext)
+  if (entry->index == index) return &entry->model;
+ return NULL;
+}
+int Mod_KnownIndex(model_t *model) { return ((modelregistry_t*)model)->index; }
+static unsigned int Mod_NameHash(const char *name)
+{
+ unsigned int hash = 2166136261u;
+ while (*name) hash = (hash ^ (unsigned char)*name++) * 16777619u;
+ return hash % countof(mod_hash);
+}
+static void Mod_FreeRegistry(void)
+{
+ modelregistry_t *entry, *next;
+ COM_WorkerFullSync();
+ for (entry = mod_first; entry; entry = next) { next = entry->next; free(entry); }
+ mod_first = mod_last = NULL;
+ memset(mod_hash, 0, sizeof(mod_hash));
+ memset(mod_indices, 0, sizeof(mod_indices));
+ mod_numknown = 0;
+}
