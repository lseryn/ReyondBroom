+// Allocate a local raw-MAP submodel for editor-owned brush entities and groups.
+void QCBUILTIN PF_brush_model_create(pubprogfuncs_t *prinst, struct globalvars_s *pr_globals)
+{
+    world_t *vmw = prinst->parms->user;
+    model_t *root = vmw->Get_CModel(vmw, 1), *sub;
+    char name[MAX_QPATH], shortname[32];
+    unsigned int number;
+    G_INT(OFS_RETURN) = 0;
+    if (!root || root->type != mod_heightmap || !root->terrain || ((heightmap_t*)root->terrain)->legacyterrain)
+        return;
+    for (number = max(1, root->numsubmodels); number < 4096; ++number)
+    {
+        Q_snprintfz(name, sizeof(name), "*%u:%s", number, root->name);
+        sub = Mod_FindName(name);
+        if (sub->loadstate != MLS_NOTLOADED) continue;
+        sub->type = mod_heightmap;
+        Mod_SetEntitiesString(sub, "", true);
+        sub->terrain = Mod_LoadTerrainInfo(sub, name, true);
+        if (!sub->terrain) return;
+        ((heightmap_t*)sub->terrain)->exteriorcontents = FTECONTENTS_EMPTY;
+        ClearBounds(sub->mins, sub->maxs);
+        sub->funcs = root->funcs;
+        sub->pvsbytes = root->pvsbytes;
+        sub->loadstate = MLS_LOADED;
+        root->numsubmodels = number + 1;
+        Q_snprintfz(shortname, sizeof(shortname), "*%u", number);
+        RETURN_TSTRING(shortname);
+        return;
+    }
+}
