+
+// Resource mounts change the meaning of model paths without replacing the document.
+static void Mod_ReloadEditorAssets_f(void)
+{
+ model_t *model;
+ int count = 0;
+ if (Cmd_IsInsecure() || !Cvar_Get("ftebroom_offline_brush_edit", "0", 0, "FTEBroom")->value) return;
+ COM_WorkerFullSync();
+ for (model=Mod_NextKnownModel(NULL); model; model=Mod_NextKnownModel(model)) {
+  if (model->loadstate == MLS_NOTLOADED || !*model->publicname || *model->publicname == '*' ||
+      model->submodelof || model->type == mod_brush || model->type == mod_heightmap) continue;
+  Mod_PurgeModel(model, MP_RESET);
+  Mod_LoadModel(model, MLV_SILENTSYNC);
+  ++count;
+ }
+ Con_Printf("FTEBroom: refreshed %d asset models after resource switch.\n", count);
 }
 
