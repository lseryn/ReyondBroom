+/* Editor model metadata only; never executes model events or game code. */
+static void QCBUILTIN PF_editor_model_info(pubprogfuncs_t *prinst, struct globalvars_s *pr_globals)
+{
+    world_t *w = prinst->parms->user;
+    model_t *mod = w->Get_CModel(w, G_FLOAT(OFS_PARM0));
+    int mode = G_FLOAT(OFS_PARM2);
+    VectorClear(G_VECTOR(OFS_RETURN));
+    if (!mod || mod->loadstate != MLS_LOADED) return;
+    if (mode == 1) VectorCopy(mod->mins, G_VECTOR(OFS_RETURN));
+    else if (mode == 2) VectorCopy(mod->maxs, G_VECTOR(OFS_RETURN));
+    else {
+        char *name; int poses=0, action=-1; float duration=0; qboolean loop=false;
+        if (Mod_FrameInfoForNum(mod, 0, G_FLOAT(OFS_PARM1), &name, &poses, &duration, &loop, &action)) {
+            G_VECTOR(OFS_RETURN)[0]=poses;G_VECTOR(OFS_RETURN)[1]=duration;G_VECTOR(OFS_RETURN)[2]=loop;
+        }
+    }
+}
